# Local environment — do NOT commit this file.
# Generated from .env.example

# ── API ──────────────────────────────────────────────────────────────────────
# Leave empty to use the Vite dev proxy (/api → https://localhost:44339).
# In production set this to https://sandbox.softgait.com https://localhost:44339
VITE_API_BASE_URL=https://localhost:44339

# ── Sentry Error Logging ─────────────────────────────────────────────────────
VITE_SENTRY_DSN=

# ── PostHog A/B Testing & Analytics ──────────────────────────────────────────
VITE_POSTHOG_KEY=phc_your_key_here
VITE_POSTHOG_HOST=https://app.posthog.com
